{
  "name": "@thanawy/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Generated API contract types and client for the Thanawy backend (OpenAPI).",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/api.ts",
    "./client": "./src/client.ts",
    "./backend-url": "./src/backend-url.ts"
  },
  "scripts": {
    "generate": "openapi-typescript swagger.json -o src/generated/api.ts",
    "check": "node scripts/check-fresh.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@thanawy/shared": "*",
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "openapi-typescript": "^7.4.4"
  }
}
