{
  "name": "thanawy-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "shared",
    "packages/contracts"
  ],
  "scripts": {
    "vercel-build": "npm run build:frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "lint:frontend": "npm run lint --prefix frontend",
    "test:frontend": "npm run test --prefix frontend",
    "audit": "node scripts/comprehensive-error-check.mjs",
    "audit:fix": "node scripts/comprehensive-error-check.mjs --fix",
    "knip": "npx knip --directory frontend",
    "build": "npm run build:frontend",
    "contracts:fetch": "node scripts/fetch-swagger.mjs",
    "contracts:generate": "npm run contracts:fetch && npm run generate:api-types",
    "integration:sync": "npm run contracts:fetch -- --source ../backend/docs/swagger.json && npm run generate:api-types && npm run contracts:type-check",
    "generate:api-types": "openapi-typescript packages/contracts/swagger.json -o packages/contracts/src/generated/api.ts",
    "contracts:check": "node scripts/check-api-types-fresh.mjs",
    "contracts:type-check": "npm run type-check --workspace @thanawy/contracts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.4",
    "swagger2openapi": "^7.0.8"
  }
}
