{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "next": true,
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/infrastructure/**/index.ts",
    "src/shared/**/index.ts",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
  "ignore": [
    "scratch/**/*",
    "brain/**/*",
    "**/*.bak.*",
    "**/*.old.*"
  ],
  "ignoreDependencies": [
    "lucide-react"
  ]
}
